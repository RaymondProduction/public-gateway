# Copy to .env and fill in. Never commit .env.

# Public IPv4 or domain of this VPS; clients use it as the WireGuard Endpoint.
SERVER_ENDPOINT=x.x.x.x

# Secret for the X-API-Token header. At least 16 characters. Generate: openssl rand -hex 24
API_TOKEN=CHANGE_ME_to_a_long_random_secret

# Optional. Private /24 for the VPN; change only before the first start.
#VPN_SUBNET=10.77.0.0/24
#WG_MTU=1380

# Optional. TCP ports that can be forwarded 1:1 to a device (PUT /ports/<n>), published on start.
#PORT_RANGE=3000-3019

# Optional. CADDY_REPLICAS=0 turns Caddy off, freeing 80/443 for forwarding to a device
# (then domains/HTTPS are handled by whatever listens on the device or by your own proxy).
#CADDY_REPLICAS=1

# Optional. Where the API is published. 0.0.0.0 = reachable from the internet (plain HTTP),
# 127.0.0.1 = only from the VPS itself (use ssh -L 8080:127.0.0.1:8080 from the laptop).
#API_BIND=0.0.0.0
#API_PORT=8080

# Optional. Pin images by digest after a verified run:
#   docker image inspect --format '{{index .RepoDigests 0}}' lscr.io/linuxserver/wireguard:latest
#WIREGUARD_IMAGE=lscr.io/linuxserver/wireguard:latest
#CADDY_IMAGE=caddy:2-alpine
#TZ=Europe/Kyiv
